rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'dnyaneshwars0611@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidDoomParticipant(data) {
      return data.keys().hasAll(['name', 'points', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'points', 'note', 'createdBy', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.points is int
        && data.points >= -999
        && data.points <= 9999
        && (!('note' in data) || (data.note is string && data.note.size() <= 80))
        && data.createdBy is string
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.createdAt is timestamp;
    }

    match /doomParticipants/{participantId} {
      // Non-PII public leaderboard: everyone can view standings; only verified admins can mutate
      allow get: if isValidId(participantId);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(participantId)
        && isValidDoomParticipant(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(participantId)
        && isValidDoomParticipant(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'points', 'note', 'updatedAt']);

      allow delete: if isAdmin()
        && isValidId(participantId);
    }

    match /admins/{uid} {
      allow get: if isVerified() && isValidId(uid) && (request.auth.uid == uid || isBootstrappedAdmin());
      allow list: if false;
      allow create: if isBootstrappedAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email']);
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }
  }
}
